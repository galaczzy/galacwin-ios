+/* Pin each directory entry used to resolve the DLL, as well as the file.
+ * A digest of an open file is not enough if a junction or symlink in its path
+ * can be retargeted before LoadLibraryExW resolves that path again. Only
+ * ordinary local DOS paths are accepted for credential-bearing sessions.
+ */
+struct path_guard { HANDLE directories[PATH_GUARD_CAP]; unsigned count; HANDLE file; };
+
+static void close_path_guard(struct path_guard *guard)
+{
+    if (guard->file != INVALID_HANDLE_VALUE) CloseHandle(guard->file);
+    while (guard->count) CloseHandle(guard->directories[--guard->count]);
+    guard->file = INVALID_HANDLE_VALUE;
+}
+
+static bool open_guarded_client(const wchar_t *path, struct path_guard *guard)
+{
+    wchar_t prefix[PATH_CAP];
+    size_t length = wcslen(path);
+    if (length < 4 || length >= PATH_CAP || path[1] != L':' || path[2] != L'\\') return false;
+    if (!((path[0] >= L'A' && path[0] <= L'Z') ||
+          (path[0] >= L'a' && path[0] <= L'z'))) return false;
+    for (size_t start = 3, i = 3; i <= length; ++i) {
+        wchar_t c = path[i];
+        if (c == L'/' || (c == L':' && i > 1)) return false;
+        if (c != L'\\' && c != L'\0') continue;
+        size_t part = i - start;
+        if (!part || (part == 1 && path[start] == L'.') ||
+            (part == 2 && path[start] == L'.' && path[start + 1] == L'.') ||
+            path[i - 1] == L'.' || path[i - 1] == L' ') return false;
+        if (c == L'\\') {
+            if (guard->count == PATH_GUARD_CAP) return false;
+            wmemcpy(prefix, path, i);
+            prefix[i] = L'\0';
+            HANDLE directory = CreateFileW(prefix, FILE_READ_ATTRIBUTES, FILE_SHARE_READ,
+                NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+            if (directory == INVALID_HANDLE_VALUE) return false;
+            guard->directories[guard->count++] = directory;
+            BY_HANDLE_FILE_INFORMATION info;
+            if (!GetFileInformationByHandle(directory, &info) ||
+                !(info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ||
+                (info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)) return false;
+            start = i + 1;
+        }
+    }
+    guard->file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING,
+                              FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+    if (guard->file == INVALID_HANDLE_VALUE) return false;
+    BY_HANDLE_FILE_INFORMATION info;
+    return GetFileInformationByHandle(guard->file, &info) &&
+           !(info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT));
+}
+
+static bool sha256_file(HANDLE file, char hex[65])
+{
+    HCRYPTPROV provider = 0;
+    HCRYPTHASH hash = 0;
+    unsigned char buffer[32768], digest[32];
+    DWORD read = 0, size = sizeof(digest);
+    LARGE_INTEGER offset = {.QuadPart = 0};
+    bool ok = false;
+    if (!SetFilePointerEx(file, offset, NULL, FILE_BEGIN) ||
+        !CryptAcquireContextW(&provider, NULL, NULL, PROV_RSA_AES, CRYPT_VERIFYCONTEXT) ||
+        !CryptCreateHash(provider, CALG_SHA_256, 0, 0, &hash)) goto done;
+    for (;;) {
+        if (!ReadFile(file, buffer, sizeof(buffer), &read, NULL)) goto done;
+        if (!read) break;
+        if (!CryptHashData(hash, buffer, read, 0)) goto done;
+    }
+    if (!CryptGetHashParam(hash, HP_HASHVAL, digest, &size, 0) || size != 32) goto done;
+    for (unsigned i = 0; i < 32; ++i) sprintf(hex + i * 2, "%02x", digest[i]);
+    hex[64] = '\0';
+    ok = true;
+done:
+    if (hash) CryptDestroyHash(hash);
+    if (provider) CryptReleaseContext(provider, 0);
+    return ok;
+}
+
+static bool verify_dependency(const wchar_t *directory, const wchar_t *name,
+                              const char *expected, struct path_guard *guard)
+{
+    wchar_t path[PATH_CAP];
+    char actual[65];
+    if (wcslen(directory) + wcslen(name) + 2 >= PATH_CAP) return false;
+    wcscpy(path, directory);
+    wcscat(path, L"\\");
+    wcscat(path, name);
+    return open_guarded_client(path, guard) &&
+           sha256_file(guard->file, actual) && !strcmp(actual, expected);
+}
